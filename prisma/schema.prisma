// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client" // or another path inside your project
}


datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        Int        @id @default(autoincrement())
  name      String
  subdomain String     @unique
  branches  Branch[]
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Vendor    Vendor[]
  Order     Order[]
}

model Branch {
  id          Int         @id @default(autoincrement())
  name        String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    Int
  isMain      Boolean     @default(false)
  employees   Employee[]
  purchases   Purchase[]
  inventories Inventory[]
  sales       Sale[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      Role
  password  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  PLATFORM_ADMIN
  TENANT_ADMIN
  MANAGER
  SUPERVISOR
  STAFF
}

model Purchase {
  id            Int            @id @default(autoincrement())
  branch        Branch         @relation(fields: [branchId], references: [id])
  branchId      Int
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  vendorId      Int
  quoteNumber   String         @unique
  status        PurchaseStatus @default(PENDING)
  totalAmount   Float
  purchaseItems PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model PurchaseItem {
  id          Int      @id @default(autoincrement())
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId  Int
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

model Inventory {
  id          Int       @id @default(autoincrement())
  productName String
  sku         String    @unique
  quantity    Int       @default(0)
  batchNumber String?
  expiryDate  DateTime?
  branch      Branch    @relation(fields: [branchId], references: [id])
  branchId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Sale {
  id            Int        @id @default(autoincrement())
  branch        Branch     @relation(fields: [branchId], references: [id])
  branchId      Int
  invoiceNumber String     @unique
  totalAmount   Float
  taxAmount     Float
  saleItems     SaleItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SaleItem {
  id          Int    @id @default(autoincrement())
  sale        Sale   @relation(fields: [saleId], references: [id])
  saleId      Int
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

model Vendor {
  id          Int        @id @default(autoincrement())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  tenantId    Int
  name        String
  contactInfo String?
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TaxRule {
  id         Int      @id @default(autoincrement())
  region     String
  taxType    String // e.g., GST, VAT
  percentage Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}
